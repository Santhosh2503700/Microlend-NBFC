# ===================================
# FRONTEND CONFIGURATION (Vite)
# ===================================
VITE_API_BASE_URL=http://localhost:8090

# ===================================
# BACKEND CONFIGURATION (Spring Boot / MySQL)
# ===================================
SERVER_PORT=8090

# Database Settings
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/microlend?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Security Key (HS256 requires at least 256 bits / 32 characters)
JWT_SECRET=your_super_secret_jwt_key_should_be_long_and_secure_12345
JWT_EXPIRATION_MS=86400000

# File Upload Directory
UPLOAD_DIR=./uploads