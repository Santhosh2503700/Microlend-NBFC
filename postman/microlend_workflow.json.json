              "name": "7.8 Branch Manager NPA Trend",
              "event": [
                { "listen": "prerequest", "script": { "type": "javascript", "exec": ["pm.environment.set('current_token', pm.environment.get('branch_manager_token'));"] } }
              ],
              "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/analytics/npa-trend?scope=branch" }
            }
          ]
        }
      ]
    },
    {
      "name": "API Library (all endpoints by role)",
      "description": "Every endpoint grouped by role. Each role folder auto-switches current_token to that role. Authenticate the role once (via its login + reset in the End-to-End folder, or the Common → Auth requests) before using its folder.",
      "item": [
        {
          "name": "Common (all roles)",
          "item": [
            {
              "name": "Login",
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{default_seed_password}}\"\n}" },
                "url": "{{base_url}}/api/auth/login"
              }
            },
            {
              "name": "Reset Password",
              "event": [ { "listen": "prerequest", "script": { "type": "javascript", "exec": ["pm.environment.set('current_token', pm.environment.get('reset_token'));"] } } ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"newPassword\": \"{{permanent_password}}\"\n}" },
                "url": "{{base_url}}/api/auth/reset-password"
              }
            },
            { "name": "Get Me", "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/auth/me" } },
            { "name": "Get Profile", "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/profile" } },
            {
              "name": "Update Profile",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Name\",\n  \"phone\": \"9876500000\",\n  \"bankAccountNumber\": \"5010099999999\",\n  \"ifscCode\": \"HDFC0009999\"\n}" },
                "url": "{{base_url}}/api/profile"
              }
            },
            { "name": "List Notifications", "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/notifications" } },
            { "name": "Unread Count", "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/notifications/unread-count" } },
            { "name": "Mark Notification Read", "request": { "method": "PUT", "header": [], "url": "{{base_url}}/api/notifications/1/read" } },
            { "name": "Ping (public)", "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{base_url}}/ping" } }
          ]
        },
        {
          "name": "NBFC Admin",
          "event": [ { "listen": "prerequest", "script": { "type": "javascript", "exec": ["pm.environment.set('current_token', pm.environment.get('admin_token'));"] } } ],
          "item": [
            { "name": "List Loan Products", "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/admin/loan-products" } },
            {
              "name": "Create Loan Product",
